# 複製這個檔案為 .env 並依實際情況修改，.env 本身不進版控（含機器相關本機設定）

# HTTP 服務埠（員工端網頁呼叫 http://localhost:<HTTP_PORT>）
HTTP_PORT=3399

# 序列埠：裝置管理員 → 連接埠(COM 與 LPT) → 插上 USB 轉 RS-232 轉接線後才會出現，例如 COM3
SERIAL_PORT=COM3

# 鮑率（已實測 WP-560 用 9600，不需更動）
BAUD=9600

# 這台櫃檯電腦預設所屬館別（hsinchu / shilin），print 呼叫未帶 gymId 時的備援值
DEFAULT_GYM=hsinchu

# 允許呼叫本代理的網頁來源（逗號分隔）；正式環境務必包含 staff 網域
ALLOWED_ORIGINS=https://staff.redrocktaiwan.com,http://localhost:5173

# 通常不用改：極少數受限環境 PATH 裡沒有 powershell.exe 才需要填完整路徑，例如
# C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
# POWERSHELL_EXE=powershell.exe
